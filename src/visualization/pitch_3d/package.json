{
  "name": "baseball-project-pitch-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Statcast CSV trajectory viewer for this baseball project",
  "type": "module",
  "scripts": {
    "build:comparison": "esbuild src/compare-entry.tsx --bundle --format=esm --minify --outfile=../../../frontend/three-viewer.js"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./Pitch3D": "./src/Pitch3D.tsx",
